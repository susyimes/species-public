# Runtime mode: seed is deterministic and does not call a model provider.
SPECIES_AGENT_MODE=seed

# Live Ark Plan agents. Never commit a real key.
ARK_PLAN_API_KEY=
ARK_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Local HTTP server. The server has no built-in authentication.
SPECIES_HOST=127.0.0.1
SPECIES_PORT=8787
SPECIES_ALLOW_INSECURE_REMOTE=0
SPECIES_ALLOW_FILE_ORIGIN=0
SPECIES_ALLOW_LOCAL_CROSS_ORIGIN=0

# Local reads are limited to the current working directory by default.
# This value accepts a JSON array or the platform path delimiter.
SPECIES_READ_ROOTS=["."]
SPECIES_ALLOW_ALL_DEVICE_READ=0

# Optional private-memory integration. Enabling this can expose selected
# content to a configured model provider.
SPECIES_ENABLE_MEMSU_READ=0
SPECIES_MEMSU_HOME=

# Trusted arbitrary-command spaces. Path checks are not an OS sandbox.
SPECIES_ENABLE_YOLO=0
SPECIES_YOLO_SPACES_FILE=.species/yolo-spaces.json

# Optional public web-search adapter.
SPECIES_WEB_SEARCH_ENDPOINT=
SPECIES_WEB_SEARCH_COMMAND=
SPECIES_WEB_SEARCH_ARGS=
SPECIES_WEB_SEARCH_TIMEOUT_MS=30000
SPECIES_WEB_SEARCH_CODEX_AUTO=0

# Runtime artifacts.
SPECIES_LEDGER_PATH=.species/room-ledger.jsonl
SPECIES_HARNESS_REPORT_DIR=.species/harness
